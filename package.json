{
  "name": "smart-house",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @smart-house/contracts build && turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @smart-house/api test:e2e",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "test:ui": "playwright test",
    "test:spike": "SPIKE_E2E=true playwright test tests/e2e/spike.spec.ts",
    "simulator": "pnpm --dir simulador start",
    "mqtt:certs": "bash infra/local/generate-mqtt-certs.sh",
    "simulator:broker:up": "docker compose -f infra/local/docker-compose.yml up -d --wait mqtt",
    "simulator:broker:down": "docker compose -f infra/local/docker-compose.yml stop mqtt",
    "infra:up": "docker compose -f infra/local/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/local/docker-compose.yml down",
    "db:migrate": "docker compose -f infra/local/docker-compose.yml exec -T postgres sh -c 'for file in /migrations/*.sql; do psql -U smart_house -d smart_house -f \"$file\"; done'",
    "db:verify:telemetry": "docker compose -f infra/local/docker-compose.yml exec -T postgres psql -X -U smart_house -d smart_house < packages/database/verify/telemetry_aggregates.sql",
    "typecheck": "turbo run typecheck",
    "format": "pnpm --recursive --if-present format"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "turbo": "^2.8.0"
  }
}
