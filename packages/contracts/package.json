{
  "name": "@smart-house/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:http-client": "openapi-typescript ../../contracts/openapi/openapi.yaml -o src/generated/openapi.ts",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "pnpm generate:http-client && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
