MQTT_URL=mqtts://localhost:8883
MQTT_CA_FILE=../infra/local/certs/ca.crt
# MQTT v5 durable sessions; commands can be queued while a device reconnects.
MQTT_SESSION_EXPIRY_SECONDS=3600
MQTT_RECONNECT_PERIOD_MS=1000
TEMPERATURE_MQTT_CLIENT_ID=smart-house-temperature
TEMPERATURE_MQTT_CERT_FILE=../infra/local/certs/device-temp-001.crt
TEMPERATURE_MQTT_KEY_FILE=../infra/local/certs/device-temp-001.key
RELAY_MQTT_CLIENT_ID=smart-house-relay
RELAY_MQTT_CERT_FILE=../infra/local/certs/device-relay-001.crt
RELAY_MQTT_KEY_FILE=../infra/local/certs/device-relay-001.key
TENANT_ID=demo
TEMPERATURE_DEVICE_ID=temp-001
RELAY_DEVICE_ID=relay-001
PUBLISH_INTERVAL_MS=30000
COMMAND_PROCESSING_DELAY_MS=100
PUBLISH_ONCE=false

# Los perfiles se aplican solo cuando se habilitan. La misma semilla y perfil
# producen las mismas decisiones de duplicado, payload invalido, rafaga y fallo.
ENABLE_SIMULATION_PROFILES=false
SIMULATION_PROFILE=normal
SIMULATION_SEED=smart-house
